# ============================================================
# COPY THIS FILE TO .env.local AND FILL IN THE VALUES
# You'll get these as you walk through the deployment steps.
# Never commit .env.local to git.
# ============================================================

# ---- SUPABASE (from Supabase dashboard > Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ---- STRIPE (from Stripe dashboard > Developers > API keys) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- TWILIO (from Twilio dashboard) ----
# Used for red alert SMS only. Phone login SMS is handled by Supabase.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1201...

# ---- HEBCAL (no signup needed — this is just the zip code) ----
HEBCAL_ZIP=07652
HEBCAL_GEONAMEID=5101798

# ---- APP CONFIG ----
NEXT_PUBLIC_APP_URL=https://minyan.cbtparamus.org
SHUL_NAME="Congregation Beth Tefillah"
SHUL_SHORT_NAME="Beth Tefillah"

# ---- CRON SECRET (for scheduled jobs) ----
# Generate a random string: openssl rand -hex 32
CRON_SECRET=
